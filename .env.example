# Telegram Bot API token from @BotFather
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"

# Full URL to your Google Spreadsheet
GOOGLE_SHEET_URL="https://docs.google.com/spreadsheets/d/your_sheet_id/edit"

# Internet Service Provider display name
PROVIDER_NAME="AeroNet"

# Path to Google Cloud service account key file
CREDENTIALS_FILE="credentials.json"

# Optional: Admin Telegram chat ID to receive instant alerts on new applications
ADMIN_CHAT_ID=""
